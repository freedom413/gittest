# Arthur Lite NSS for JDCloud RE-SS-01 / IPQ6018 / 512 MiB RAM
# Source: laipeng668/LibWrt @ 96a0ec8a427909c4d9ef112641b36bcc0728fa43
# Target kernel partition: HLOS 6 MiB. Do not change the device profile.

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# 512 MiB platform and NSS 11.4 (required for IPQ60xx NSS Wi-Fi offload)
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
CONFIG_NSS_DRV_BRIDGE_ENABLE=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y

# NSS driver and ECM data path
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y

# LuCI web management, simplified Chinese
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-firewall=y

# One proxy stack only: HomeProxy + sing-box
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_sing-box=y

# Minimal diagnostics
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
